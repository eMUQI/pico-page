set(PICO_PAGE_BOARD_ID "read_pico")
set(PICO_PAGE_MANIFEST_URL "https://picopage.wulu.zone/firmware/ota-v2/manifest.json")
set(PICO_PAGE_UPDATE_LAYOUT "ota7")
set(pico_page_partition_table "${CMAKE_CURRENT_LIST_DIR}/../partitions.build.csv")
cmake_path(NORMAL_PATH pico_page_partition_table)
if(NOT ESP_PLATFORM AND NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pico_page_partition_table}")
endif()

function(pico_page_read_partition label kind subtype)
    file(STRINGS "${pico_page_partition_table}" row REGEX "^${label},")
    if(NOT row MATCHES "^${label},${kind},${subtype},(0x[0-9A-Fa-f]+),(0x[0-9A-Fa-f]+),$")
        message(FATAL_ERROR "Invalid or duplicate partition definition for ${label}")
    endif()
    string(TOUPPER "${label}" key)
    set(PICO_PAGE_${key}_OFFSET "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(PICO_PAGE_${key}_SIZE "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

pico_page_read_partition(nvs data nvs)
pico_page_read_partition(phy_init data phy)
pico_page_read_partition(ota_0 app ota_0)
pico_page_read_partition(ota_1 app ota_1)
pico_page_read_partition(otadata data ota)
math(EXPR PICO_PAGE_UPDATE_SLOT_BYTES "${PICO_PAGE_OTA_0_SIZE}")
math(EXPR ota_1_bytes "${PICO_PAGE_OTA_1_SIZE}")
if(NOT PICO_PAGE_UPDATE_SLOT_BYTES EQUAL ota_1_bytes)
    message(FATAL_ERROR "OTA slots must have the same capacity")
endif()
