+enum EpdDrawError epd_clear_checked(void) {
+    render_context.error = EPD_DRAW_SUCCESS;
+    atomic_store(&render_context.invalid_line_threads, 0);
+    atomic_store(&render_context.empty_line_queues, 0);
+    atomic_store(&render_context.short_scans, 0);
+    atomic_store(&render_context.first_empty_line, -1);
+    epd_clear();
+    if (render_context.error != EPD_DRAW_SUCCESS) {
+        ESP_LOGE("epdiy", "clear failed error=%u short=%u",
+            (unsigned)render_context.error, atomic_load(&render_context.short_scans));
+    }
+    return render_context.error;
