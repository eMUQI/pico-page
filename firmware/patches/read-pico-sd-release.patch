+esp_err_t read_pico_sd_release(void) {
+    if (!begin_operation()) return ESP_ERR_NOT_FINISHED;
+    esp_err_t err = card ? esp_vfs_fat_sdcard_unmount(SD_MOUNT_POINT, card) : ESP_OK;
+    if (err == ESP_OK) card = NULL;
+    read_pico_sd_info_t info = { .error = err == ESP_OK ? ESP_ERR_INVALID_STATE : err };
+    info.mounted = err != ESP_OK && card != NULL;
+    publish_info(&info);
+    return err;
+}
+
