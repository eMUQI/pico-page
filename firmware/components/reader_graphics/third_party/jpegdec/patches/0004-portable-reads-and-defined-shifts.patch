+// Byte assembly avoids unaligned typed loads and preserves the selected bit-reader width.
+static inline my_ulong jpeg_read_be(const uint8_t* p, unsigned count) {
+    my_ulong value = 0;
+    for (unsigned i = 0; i < count; ++i) value = (value << 8) | p[i];
+    return value;
+}
+#define INTELSHORT(p) ((uint16_t)((p)[0] | ((uint16_t)(p)[1] << 8)))
+#define INTELLONG(p) ((uint32_t)(p)[0] | ((uint32_t)(p)[1] << 8) | ((uint32_t)(p)[2] << 16) | ((uint32_t)(p)[3] << 24))
+#define MOTOSHORT(p) ((uint16_t)jpeg_read_be((p), 2))
+#define MOTOLONG(p) jpeg_read_be((p), sizeof(my_ulong))
 
 #endif // __JPEGDEC__
