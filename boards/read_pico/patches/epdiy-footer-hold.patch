+void epd_set_unchanged_pixel_hold(int first_column) {
+    // Only the display owner calls this after all synchronous producers return.
+    heap_caps_free(unchanged_pixel_mask);
+    unchanged_pixel_mask = NULL;
+    unchanged_pixel_mask_prepared = false;
+    unchanged_pixel_hold = first_column;
+}
+
+static void prepare_unchanged_pixel_mask(const uint8_t* data) {
+    if (unchanged_pixel_mask_prepared) return;
+    unchanged_pixel_mask_prepared = true;
+    const int width = epd_width();
+    const int height = epd_height();
+    if (unchanged_pixel_hold < 0 || unchanged_pixel_hold >= width || width % 64 != 0) return;
+    const int stride = width / 4 - unchanged_pixel_hold / 64 * 16;
+    unchanged_pixel_mask = heap_caps_aligned_alloc(
+        16, (size_t)stride * height, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (unchanged_pixel_mask == NULL) {
+        ESP_LOGW("epdiy", "Footer hold unavailable; using normal grayscale update");
+        return;
+    }
+    for (int row = 0; row < height; ++row) {
+        epd_build_unchanged_suffix_mask(data + (size_t)row * width,
+            unchanged_pixel_mask + (size_t)row * stride, unchanged_pixel_hold, width);
+    }
+}
