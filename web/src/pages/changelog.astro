---
import { readdirSync, readFileSync } from "node:fs";
import Site from "../layouts/Site.astro";

// Release notes are written once, in docs/releases/<version>.md: the update manifest carries
// them to devices and this page renders the same files.
const directory = "../docs/releases";

// Order of docs/versioning.md: X.Y.Z-beta.N before X.Y.Z-rc.N before X.Y.Z.
function order(version) {
  const [core, stage = ""] = version.split("-");
  const [name, number = "0"] = stage.split(".");
  return [...core.split(".").map(Number), ["beta", "rc", ""].indexOf(name), Number(number)];
}
const newestFirst = (a, b) => {
  const [x, y] = [order(a), order(b)];
  const at = x.findIndex((part, index) => part !== y[index]);
  return at < 0 ? 0 : y[at] - x[at];
};

// The same subset of Markdown the device shows: headings, list items, paragraphs, **bold** and
// `code`; a link keeps only its text. Returns [{ kind: "heading" | "list" | "text", ... }].
function blocks(markdown) {
  const spans = (line) => line.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1").split(/(\*\*[^*]+\*\*|`[^`]+`)/).filter(Boolean).map((part) =>
    part.startsWith("**") ? { bold: part.slice(2, -2) } : part.startsWith("`") ? { code: part.slice(1, -1) } : { text: part });
  const result = [];
  for (const line of markdown.split("\n").map((line) => line.trim()).filter(Boolean)) {
    const heading = line.match(/^#{1,3} +(.*)$/);
    const item = line.match(/^[-*] +(.*)$/);
    if (heading) result.push({ kind: "heading", spans: spans(heading[1]) });
    else if (!item) result.push({ kind: "text", spans: spans(line) });
    else if (result.at(-1)?.kind === "list") result.at(-1).items.push(spans(item[1]));
    else result.push({ kind: "list", items: [spans(item[1])] });
  }
  return result;
}

// The website build stores the published releases beside the fetched firmware. Notes merged
// ahead of their release stay off the page; a build without the list shows every file, undated.
let published;
try {
  published = new Map(JSON.parse(readFileSync("public/firmware/releases.json", "utf8")).map(
    (release) => [release.tagName, new Date(release.publishedAt).toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" })]));
} catch (error) {
  if (error.code !== "ENOENT") throw error;
}
const releases = readdirSync(directory).filter((name) => name.endsWith(".md")).map((name) => name.slice(0, -3))
  .filter((version) => !published || published.has(`v${version}`))
  .sort(newestFirst)
  .map((version) => ({ version, date: published?.get(`v${version}`), blocks: blocks(readFileSync(`${directory}/${version}.md`, "utf8")) }));
---
<Site title="更新日志 · Pico Page" description="Pico Page 各版本的更新日志。" current="changelog">
  <article class="changelog">
    <h1>更新日志</h1>
    <p class="lead">同样的内容会在设备的「设置 → 固件更新」里显示。新版本可在<a href="/install/">安装页</a>安装，也可按<a href="/docs/#update">联网更新说明</a>在设备上更新。</p>
    {releases.length === 0 && <p class="notice">还没有发布的版本。</p>}
    {releases.map(({ version, date, blocks }) => (
      <section id={`v${version}`}>
        <h2><span>{version}</span>{date && <time class="mono" datetime={date}>{date}</time>}</h2>
        {blocks.map((block) => {
          const inline = (spans) => spans.map((span) => span.bold ? <strong>{span.bold}</strong> : span.code ? <code>{span.code}</code> : span.text);
          if (block.kind === "heading") return <h3>{inline(block.spans)}</h3>;
          if (block.kind === "list") return <ul>{block.items.map((item) => <li>{inline(item)}</li>)}</ul>;
          return <p>{inline(block.spans)}</p>;
        })}
      </section>
    ))}
  </article>
</Site>

<style>
  .changelog {
    max-width: 46em;
    padding: 56px 0 72px;
    font-size: 16px;
    line-height: 1.85;
    color: var(--text);
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(34px, 4.6vw, 54px);
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
  }
  .lead,
  .notice {
    margin-top: 14px;
  }
  h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: 56px;
    border-top: 1px solid var(--ink);
    padding-top: 20px;
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    scroll-margin-top: 24px;
  }
  h2 time {
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }
  h3 {
    margin-top: 28px;
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }
  section ul,
  section p {
    margin-top: 10px;
  }
  section ul {
    padding-left: 1.4em;
    list-style: disc;
  }
</style>
