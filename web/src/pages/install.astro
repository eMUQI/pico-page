---
import Site from "../layouts/Site.astro";
import { firmware } from "../firmware.js";

const steps = ["安装前确认", "连接并写入", "放入书和字体", "开始阅读"];
const recovery = "找不到串口，或选择串口后无法连接、烧录时，请先唤醒设备并保持 USB 连接。仍无法连接时，在开机状态下快速短按电源键两次（间隔不超过 1.2 秒），再按住电源键至少 3 秒，进入烧录模式。松开后，重新点击「连接设备」并选择串口。";
---
<Site title="安装固件 · Pico Page" description="在电脑版 Chrome 或 Edge 中，用 USB 线把 Pico Page 安装到 Read Pico，再放入书和字体。" current="install">
  <!-- TODO: 手动安装方法确定后恢复设计稿中的「完整安装文档与手动安装方法」链接。 -->
        <section class="intro">
          <div>
            <p class="eyebrow">安装固件</p>
            <h1>把 Read Pico，<br>变成 Pico Page。</h1>
          </div>
          <ul class="needs">
            <li><span>设备</span><span>Read Pico 4.7″</span></li>
            <li><span>数据线</span><span>支持数据传输的 USB 线</span></li>
            <li><span>浏览器</span><span>电脑版 Chrome 或 Edge</span></li>
            <li><span>TF 卡</span><span>FAT 文件系统</span></li>
          </ul>
        </section>
        <ol class="tracker" aria-label="安装步骤">
          {steps.map((title, index) => (
            <li class={index < 1 ? "past" : undefined} aria-current={index === 1 ? "step" : undefined}><span>0{index + 1}</span><strong>{title}</strong></li>
          ))}
        </ol>
        <div class="layout">
          <div class="steps">
            <article class="step">
              <span class="number" aria-hidden="true">1</span>
              <div>
                <h2>安装前确认</h2>
                <ul class="checks">
                  <li><span aria-hidden="true">☐</span><span>写入会替换设备上现有的阅读程序。需要回到官方系统时，请先阅读<a href="https://dot.mindreset.tech/docs/read_0/firmware" target="_blank" rel="noopener" target="_blank" rel="noopener">官方的构建与烧录说明</a>：目前需要用 ESP-IDF 从源码构建后烧录。</span></li>
                  <li><span aria-hidden="true">☐</span><span>安装会<strong>整片覆盖</strong>设备闪存，包括 bootloader 和分区表。无论设备上现在是原厂系统还是其他固件，都可以直接安装；启用了闪存加密或安全启动的设备除外，本页会拒绝写入。TF 卡不受影响。</span></li>
                  <li><span aria-hidden="true">☐</span><span>设备电量充足，或保持 USB 供电。</span></li>
                </ul>
              </div>
            </article>
            <article class="step">
              <span class="number" aria-hidden="true">2</span>
              <div>
                <h2>连接设备并写入</h2>
                <p>用 USB 线连接电脑，点击「连接设备」，在浏览器弹窗里选择 Read Pico 的串口。写入期间请保持页面打开、电脑唤醒、数据线不动。</p>
                <p>设备正在进行 USB 文件传输时，请先在电脑上安全弹出 TF 卡，再在设备上退出传输并确认重启，然后连接安装。</p>
                <div class="flash" data-phase={firmware ? "idle" : "unreleased"} data-url={firmware?.url} data-version={firmware?.version} data-sha256={firmware?.sha256}>
                  <div class="flash-head">
                    <span class="flash-status" aria-live="polite"><span class="dot"></span><span data-el="status">{firmware ? "未连接" : "尚未开放"}</span></span>
                    {firmware && <span class="mono">Pico Page {firmware.version} · <a href={`/changelog/#v${firmware.version}`}>更新日志</a></span>}
                  </div>
                  {firmware ? (
                    <div class="flash-body">
                      <p class="notice" data-el="error" role="alert" hidden></p>
                      <div data-panel="failed" hidden>
                        <div class="failure-message" role="alert" aria-atomic="true">
                          <h3 data-el="failure-title"></h3>
                          <p data-el="failure-message"></p>
                          <p class="error-code">错误码：<span class="mono" data-el="failure-code"></span></p>
                        </div>
                        <button class="primary" type="button" data-el="retry">重新连接并重试</button>
                        <div class="diagnostics" data-el="diagnostics" hidden>
                          <div class="diagnostic-actions">
                            <button class="secondary" type="button" data-el="copy-diagnostics">复制错误信息</button>
                            <span data-el="copy-status" role="status"></span>
                          </div>
                          <details data-el="diagnostic-details">
                            <summary>查看详情</summary>
                            <textarea data-el="diagnostic-text" aria-label="错误详情" readonly rows="10" spellcheck="false"></textarea>
                          </details>
                        </div>
                        <details data-el="connection-help" hidden>
                          <summary>无法连接设备？</summary>
                          <p>{recovery}</p>
                        </details>
                      </div>
                      <div data-panel="idle">
                        <p data-el="hint">尚未连接。{recovery}</p>
                        <button class="primary" type="button" data-el="connect">连接设备</button>
                      </div>
                      <div data-panel="connected" hidden>
                        <dl>
                          <div><dt>芯片</dt><dd>ESP32-S3 · 16 MiB 闪存</dd></div>
                          <div><dt>方式</dt><dd>整片覆盖写入</dd></div>
                        </dl>
                        <p class="notice">安装会清除设备内部闪存，替换现有固件。TF 卡上的书籍、阅读进度和 Pico Page 设置（包括已保存的 Wi‑Fi）不受影响。其他固件保存在内部闪存中的设置会被清除。回到官方系统的方法见第 1 步中的官方说明。</p>
                        <label class="confirm"><input type="checkbox" data-el="confirm"><span>我确认连接的是 Read Pico。本页只能核对芯片型号和闪存容量；连接的是其他设备时，它的内部闪存也会被清除。</span></label>
                        <div class="choices">
                          <button class="primary" type="button" data-el="install" disabled>安装 Pico Page</button>
                          <button class="secondary" type="button" data-el="disconnect">断开</button>
                        </div>
                      </div>
                      <div data-panel="writing" hidden>
                        <div class="progress-line"><span data-el="stage" role="status"></span><span class="mono" data-el="percent"></span></div>
                        <div class="track" role="progressbar" aria-label="安装进度" aria-valuemin="0" aria-valuemax="100"><div data-el="bar"></div></div>
                        <p class="keep">请勿拔线或关闭页面。</p>
                      </div>
                      <div data-panel="done" hidden>
                        <p class="finished">固件已写入并通过校验。</p>
                        <p class="after">请等待设备启动并显示书库。本页无法确认设备是否已正常启动。屏幕没有变化时，按住电源键约 10 秒强制关机，松开后再按住 1 秒以上开机。</p>
                        <div class="choices"><a class="primary" href="#step3">下一步：放入书和字体 ↓</a></div>
                      </div>
                    </div>
                  ) : (
                    <div class="flash-body">
                      <div>
                        <p>网页安装尚未开放。项目仍在开发中，开放后可以在这里安装。</p>
                        <button class="primary" type="button" disabled>连接设备</button>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </article>
            <article id="step3" class="step">
              <span class="number" aria-hidden="true">3</span>
              <div>
                <h2>放入书和字体</h2>
                <p>把 TF 卡接到电脑，或在设备上开启 USB 文件传输，按下面的结构放好文件。</p>
                <div class="tree">
                  <div class="muted">TF 卡/</div>
                  <div><span>├─ <strong>Books/</strong></span><span>EPUB、TXT</span></div>
                  <div><span>├─ <strong class="accent">Fonts/</strong></span><span class="accent">中文字体，强烈建议</span></div>
                  <div><span>└─ LockScreens/</span><span class="muted">锁屏图片，可选</span></div>
                </div>
                <div class="font-note">
                  <p>内置字体只有 3,500 个常用汉字，其余字符显示为方框。推荐霞鹜文楷，按 SIL OFL 1.1 免费分发。</p>
                  <a href="/downloads/LXGWWenKai-Regular-v1.520.zip" download>下载霞鹜文楷 ↓</a>
                </div>
              </div>
            </article>
            <article class="step">
              <span class="number" aria-hidden="true">4</span>
              <div>
                <h2>打开书，选字体</h2>
                <p>TF 卡插回设备后重启（长按电源键，选「重启」）。在书库打开一本书，轻点正文中部 → 「排版」 → 选择放入的字体。按 K1、K3 翻页，有残影时按 K2 全刷。短按电源键休眠。离线说明在「设置 → 使用说明」。</p>
              </div>
            </article>
          </div>
          <aside>
            <div>
              <h3>已经在用 Pico Page？</h3>
              <p>可在「设置 → 固件更新」中检查并安装新版本，条件与步骤见<a href="/docs/#update">联网更新说明</a>。也可以在这个页面重新安装。TF 卡上的书籍、进度和 Pico Page 设置（包括已保存的 Wi‑Fi）不受影响。</p>
            </div>
            <div>
              <h3>遇到问题</h3>
              <details>
                <summary>找不到串口，或有串口但无法连接</summary>
                <p>休眠时串口可能仍可见，但无法连接或烧录。{recovery}</p>
                <p>设备没有响应时，按住电源键约 10 秒强制关机，松开后再按住 1 秒以上开机，然后重试。仍无法连接时，确认数据线支持数据传输，换一个 USB 接口，并关闭占用串口的其他程序和浏览器标签。</p>
              </details>
              <details>
                <summary>装过其他固件，还能装吗</summary>
                <p>可以。安装会整片覆盖，替换原有的 bootloader 和分区表，不需要先刷回原厂系统。例外是启用了闪存加密或安全启动的设备：本页写入的固件无法在它上面启动，连接后会拒绝安装。</p>
              </details>
              <details>
                <summary>写入中断</summary>
                <p>保持供电，重新连接并安装一次。无法连接时，按上方说明进入烧录模式，再重新选择串口。</p>
              </details>
              <details>
                <summary>写入完成，屏幕没变化</summary>
                <p>墨水屏断电后会保留旧画面。按住电源键约 10 秒强制关机，松开后再按住 1 秒以上开机；仍无变化时，重新连接并安装一次。</p>
              </details>
              <details>
                <summary>书里有空白方框</summary>
                <p>这是内置字体缺字。把完整中文字体放进 <code>Fonts/</code>，并在「排版」中选择它。</p>
              </details>
            </div>
          </aside>
        </div>
  <script>
      // Installs the full-flash image over Web Serial. The serial protocol comes from esptool-js,
      // fetched when the visitor connects.
      const card = document.querySelector(".flash[data-url]");
      if (card) {
        const { url, version, sha256 } = card.dataset;
        const el = (name) => card.querySelector(`[data-el="${name}"]`);
        const steps = document.querySelectorAll(".tracker li");
        const labels = { idle: "未连接", connected: "已连接", writing: "正在安装", done: "写入与校验完成", failed: "安装未完成" };
        let transport, loader, md5;

        function show(phase, error = "", diagnostic = "") {
          card.dataset.phase = phase;
          if (phase !== "writing") progress("", 0);
          el("status").textContent = labels[phase];
          el("error").textContent = error;
          el("error").hidden = !error;
          el("diagnostics").hidden = !diagnostic;
          el("diagnostic-text").value = diagnostic;
          el("diagnostic-details").open = false;
          el("copy-status").textContent = "";
          el("connection-help").hidden = true;
          el("connection-help").open = false;
          el("confirm").checked = false;
          el("install").disabled = true;
          card.querySelectorAll("[data-panel]").forEach((panel) => (panel.hidden = panel.dataset.panel !== phase));
          const current = phase === "done" ? 2 : 1;
          steps.forEach((step, index) => {
            step.classList.toggle("past", index < current);
            if (index === current) step.setAttribute("aria-current", "step");
            else step.removeAttribute("aria-current");
          });
        }

        function showFailure({ title, message, code, diagnostic, status = "安装未完成" }) {
          show("failed", "", diagnostic);
          el("status").textContent = status;
          el("failure-title").textContent = title;
          el("failure-message").textContent = message;
          el("failure-code").textContent = code;
          el("connection-help").hidden = !["CONNECT_FAILED", "FLASH_FAILED"].includes(code);
          el("retry").disabled = !("serial" in navigator);
        }

        function diagnosticInfo(code, stage, error, details = {}) {
          // Version and request identifiers locate the resource without sharing its download URL.
          return Object.entries({
            "诊断格式": "Pico Page installer v1",
            "错误码": code,
            "失败阶段": stage,
            "时间（UTC）": new Date().toISOString(),
            "固件版本": version,
            "异常类型": error?.name || "未知",
            ...details,
            "浏览器": navigator.userAgent,
          }).map(([key, value]) => `${key}: ${value}`).join("\n");
        }

        el("copy-diagnostics").addEventListener("click", async () => {
          const report = el("diagnostic-text").value;
          try {
            await navigator.clipboard.writeText(report);
            if (el("diagnostic-text").value === report) el("copy-status").textContent = "已复制";
          } catch {
            if (el("diagnostic-text").value !== report) return;
            el("diagnostic-details").open = true;
            el("diagnostic-text").focus();
            el("diagnostic-text").select();
            el("copy-status").textContent = "请在下方手动复制";
          }
        });

        function progress(stage, percent = null) {
          const track = el("bar").parentElement;
          el("stage").textContent = stage;
          el("percent").hidden = percent === null;
          el("percent").textContent = percent === null ? "" : `${percent}%`;
          track.dataset.indeterminate = String(percent === null);
          track.setAttribute("aria-label", stage || "安装进度");
          el("bar").style.width = percent === null ? "" : `${percent}%`;
          if (percent === null) track.removeAttribute("aria-valuenow");
          else track.setAttribute("aria-valuenow", percent);
        }

        // Restarts an ESP32-S3 with its RTC watchdog, as esptool's watchdog_reset does. Read Pico
        // stays in download mode after the RTS reset of esptool-js.
        async function restart() {
          await loader.writeReg(0x600080b0, 0x50d83aa1); // RTC_CNTL_WDTWPROTECT: unlock
          await loader.writeReg(0x6000809c, 2000); // RTC_CNTL_WDTCONFIG1: timeout
          await loader.writeReg(0x60008098, ((1 << 31) | (5 << 28) | (1 << 8) | 2) >>> 0); // RTC_CNTL_WDTCONFIG0: enable, reset the system
          // The chip may restart before it answers the write that locks the registers again.
          await loader.writeReg(0x600080b0, 0).catch(() => {});
        }

        // Attempts to leave download mode and free the port. The result reports command and
        // cleanup success, not an observed firmware boot; reloading can free an unclosed port.
        async function release() {
          let clean = true;
          if (loader?.chip?.CHIP_NAME === "ESP32-S3") {
            // The restart removes the USB serial port, so closing it afterwards may fail.
            await restart().then(() => transport.disconnect().catch(() => {}), () => (clean = false));
          }
          if (!clean || loader?.chip?.CHIP_NAME !== "ESP32-S3") {
            clean = true;
            await loader?.after("hard_reset").catch(() => (clean = false));
            await transport?.disconnect().catch(() => (clean = false));
          }
          transport = loader = undefined;
          return clean;
        }

        async function connect(button) {
          window.dispatchEvent(new CustomEvent("pico-page:analytics", { detail: "device_connect" }));
          let port;
          try {
            port = await navigator.serial.requestPort({ filters: [{ usbVendorId: 0x303a }] });
          } catch {
            return; // The visitor closed the chooser.
          }
          const buttonLabel = button.textContent;
          button.disabled = true;
          button.textContent = "正在连接…";
          try {
            const [{ ESPLoader, Transport }, { default: SparkMD5 }] = await Promise.all([import("esptool-js"), import("spark-md5")]);
            md5 = (image) => SparkMD5.ArrayBuffer.hash(image.slice().buffer);
            transport = new Transport(port, false);
            loader = new ESPLoader({ transport, baudrate: 115200 });
            await loader.main();
            // Only the stub that main() loads can erase the whole chip; without it the old boot
            // data would survive the installation.
            if (!loader.IS_STUB) throw new Error("The flasher stub is not running");
            let refusal = "";
            // Read Pico is an ESP32-S3 with 16 MiB of flash. Other boards match this too, so the
            // visitor confirms the device before installing.
            if (loader.chip.CHIP_NAME !== "ESP32-S3" || (await loader.detectFlashSize()) !== "16MB") {
              refusal = "连接的设备不是 Read Pico，没有写入任何内容。";
            } else {
              // Read from the ROM during chip detection. The image is plaintext and unsigned: it
              // would not start on a chip with flash encryption (an odd number of counter bits
              // set) or secure boot.
              const security = await loader.getSecurityInfo();
              const encrypted = security.flashCryptCnt.toString(2).replaceAll("0", "").length % 2 === 1;
              if (encrypted || security.parsedFlags.SECURE_BOOT_EN) {
                refusal = "这台设备启用了闪存加密或安全启动，本页写入的固件无法在它上面启动。没有写入任何内容。";
              }
            }
            if (refusal) {
              await release();
              show("idle", refusal);
            } else {
              show("connected");
            }
          } catch (error) {
            console.error(error);
            await release();
            showFailure({
              title: "未能连接设备",
              message: "请关闭占用串口的其他程序或浏览器标签，再试一次。本次尚未擦除或写入设备闪存。",
              code: "CONNECT_FAILED",
              diagnostic: diagnosticInfo("CONNECT_FAILED", "连接设备", error),
              status: "连接未完成",
            });
          } finally {
            button.disabled = false;
            button.textContent = buttonLabel;
          }
        }

        async function install() {
          window.dispatchEvent(new CustomEvent("pico-page:analytics", { detail: "install_start" }));
          show("writing");
          progress("正在下载固件");
          let erasing = false;
          let stage = "请求固件", code = "DOWNLOAD_UNREACHABLE";
          let title = "暂时无法下载固件";
          let failure = "请稍后重试；若仍失败，请检查网络连接。";
          const started = performance.now();
          const details = { "HTTP 状态": "未取得响应（连接失败或浏览器不允许读取响应）" };
          try {
            const response = await fetch(url);
            details["HTTP 状态"] = response.status;
            // These identifiers are available only when the server exposes them through CORS.
            for (const header of ["x-cos-request-id", "x-oss-request-id", "x-request-id", "cf-ray"]) {
              const value = response.headers.get(header);
              if (value && /^[\w.-]{1,128}$/.test(value)) details[header] = value;
            }
            if (!response.ok) {
              code = `DOWNLOAD_HTTP_${response.status}`;
              if (response.status === 401 || response.status === 403) {
                title = "下载请求被拒绝";
                failure = "请稍后重试。";
              } else if (response.status === 429) {
                title = "下载请求过于频繁";
                failure = "请稍后重试，避免连续点击安装。";
              } else if (response.status === 404) {
                title = "未找到固件文件";
                failure = "请刷新页面后重试。";
              } else if (response.status >= 500) {
                title = "下载服务暂不可用";
                failure = "请稍后重试。";
              } else {
                title = "固件下载未成功";
                failure = "请稍后重试。";
              }
              throw new Error(`HTTP ${response.status}`);
            }
            stage = "接收固件";
            code = "DOWNLOAD_INTERRUPTED";
            title = "固件下载中断";
            failure = "请稍后重试。";
            const image = new Uint8Array(await response.arrayBuffer());
            details["已接收字节数"] = image.byteLength;
            stage = "校验固件";
            code = "VERIFY_FAILED";
            title = "未能完成固件校验";
            failure = "请刷新页面后重试。";
            progress("正在校验下载的固件");
            const digest = new Uint8Array(await crypto.subtle.digest("SHA-256", image));
            details["预期 SHA-256"] = sha256;
            details["实际 SHA-256"] = Array.from(digest, (byte) => byte.toString(16).padStart(2, "0")).join("");
            if (details["实际 SHA-256"] !== sha256) {
              code = "VERIFY_MISMATCH";
              title = "固件校验未通过";
              failure = "请重新连接并重试。";
              throw new Error("The downloaded image does not match the published digest");
            }
            stage = "擦除整片闪存";
            code = "FLASH_FAILED";
            erasing = true;
            progress("正在擦除整片闪存");
            await loader.eraseFlash();
            stage = "准备写入";
            progress("正在准备写入");
            await loader.writeFlash({
              fileArray: [{ data: image, address: 0 }],
              flashMode: "keep",
              flashFreq: "keep",
              flashSize: "keep",
              eraseAll: false,
              compress: true,
              calculateMD5Hash: md5,
              reportProgress: (_, written, total) => {
                // The final transfer callback precedes flash finalization and MD5 verification.
                stage = written < total ? "写入固件" : "完成写入并校验";
                progress(`正在${stage}`, written < total ? Math.floor((written / total) * 100) : null);
              },
            });
            progress("正在发送重启指令");
            show("done", (await release()) ? "" : "固件已写入并通过校验，但设备可能没有自动重启。请按住电源键约 10 秒强制关机，松开后再按住 1 秒以上开机。");
            window.dispatchEvent(new CustomEvent("pico-page:analytics", { detail: "install_success" }));
          } catch (error) {
            window.dispatchEvent(new CustomEvent("pico-page:analytics", { detail: "install_failure" }));
            console.error(error);
            details["耗时（毫秒）"] = Math.round(performance.now() - started);
            details["已进入擦写流程"] = erasing ? "是" : "否";
            const diagnostic = diagnosticInfo(code, stage, error, details);
            progress("正在释放连接");
            await release();
            showFailure({
              title: erasing ? "安装未完成" : title,
              message: erasing ? "请保持供电，重新连接后再安装一次。" : `${failure}本次尚未擦除或写入设备闪存。`,
              code, diagnostic,
              status: erasing ? "安装未完成" : stage === "校验固件" ? "校验未完成" : "下载未完成",
            });
          }
        }

        el("connect").addEventListener("click", () => connect(el("connect")));
        el("retry").addEventListener("click", () => connect(el("retry")));
        el("install").addEventListener("click", install);
        el("confirm").addEventListener("change", () => (el("install").disabled = !el("confirm").checked));
        el("disconnect").addEventListener("click", async () => {
          show("idle", (await release()) ? "" : "串口没有正常释放，设备可能仍在下载模式。请按住电源键约 10 秒强制关机，松开后再按住 1 秒以上开机；无法再次连接时，刷新本页。");
        });
        // A connected device runs the flasher stub until it is reset, and closing the page cannot
        // reset it. The browser asks before leaving while connected or writing.
        addEventListener("beforeunload", (event) => {
          if (["connected", "writing"].includes(card.dataset.phase)) event.preventDefault();
        });
        if (!("serial" in navigator)) {
          el("hint").textContent = "这个浏览器不能连接设备。请用电脑版 Chrome 或 Edge 打开本页。";
          el("connect").disabled = true;
        }
      }
  </script>
</Site>
