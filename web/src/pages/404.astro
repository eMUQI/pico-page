---
// Cloudflare Pages requires a top-level 404.html to avoid serving the home page for an absent update manifest.
import Site from "../layouts/Site.astro";
---
<Site title="找不到这一页 · Pico Page" noindex>
  <section>
    <p class="eyebrow">404</p>
    <h1>找不到这一页。</h1>
    <p>地址可能有误，或者页面已经移走。</p>
    <a class="primary" href="/">回到首页</a>
  </section>
</Site>
<style>
  section {
    padding: clamp(48px, 7vw, 80px) 0 96px;
  }
  h1 {
    margin-top: 12px;
    font-family: var(--serif);
    font-size: clamp(34px, 4.6vw, 54px);
    font-weight: 700;
    line-height: 1.25;
  }
  h1 + p {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
  }
  .primary {
    margin-top: 34px;
    padding: 0 24px;
  }
</style>
