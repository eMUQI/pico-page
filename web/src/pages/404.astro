---
// Unknown paths answer 404 with this page. The device's update check relies on that status to
// tell "no firmware published" from a manifest it cannot read.
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f3f3f0">
    <meta name="robots" content="noindex">
    <title>找不到这一页 · Pico Page</title>
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Pico Page 首页">Pico Page<span class="brand-period">.</span></a>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="missing-title">
        <div class="hero-copy">
          <p class="eyebrow">404</p>
          <h1 id="missing-title">找不到这一页。</h1>
          <p class="hero-description">地址可能有误，或者页面已经移走。</p>
          <div class="actions">
            <a class="button primary" href="/">回到首页</a>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer wrap">
      <p><span class="footer-brand">Pico Page.</span><span>读自己的书，接着读下去。</span></p>
    </footer>
  </body>
</html>
