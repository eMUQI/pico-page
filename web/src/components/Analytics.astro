---
const id = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
{id && /^G-[A-Z0-9]+$/.test(id) && (
  <script is:inline define:vars={{ id }}>
    (() => {
      if (location.hostname !== 'picopage.wulu.zone') return;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
      });
      window.gtag('js', new Date());
      window.gtag('config', id, {
        cookie_domain: location.hostname,
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
      document.head.append(script);
      window.addEventListener('pico-page:analytics', (event) => {
        if (['device_connect', 'install_start', 'install_success', 'install_failure'].includes(event.detail)) {
          window.gtag('event', event.detail);
        }
      });
    })();
  </script>
)}
