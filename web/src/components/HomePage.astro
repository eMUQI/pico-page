---
import Site from "../layouts/Site.astro";
import { firmware } from "../firmware.js";

const screens = [
  { id: "library", title: "书库", description: "书籍与文件夹，一目了然。列表和封面卡片，按习惯切换。", alt: "书库卡片视图，显示继续阅读入口和另外两本示例书" },
  { id: "reading", title: "正文", description: "按键或轻点屏幕两侧翻页，底部随时查看阅读进度。", alt: "示例书籍正文，底部显示页码和电量" },
  { id: "tools", title: "阅读工具", description: "轻点正文中部，打开目录、排版、同步、刷新模式和全刷。", alt: "正文上的阅读工具，包含目录、排版、同步、刷新模式和全刷入口" },
  { id: "typography", title: "排版", description: "字体、字重、字号、行距等设置，先看预览，再应用到这本书。", alt: "示例书籍的排版面板，字号改为 40 px，尚未应用" },
  { id: "sync", title: "位置接续", description: "检查远端位置后，选择继续阅读的位置；上传前确认。", alt: "示例书籍的同步面板，分别显示本机与远端阅读位置" },
  { id: "sleep", title: "休眠", description: "封面、正文、简洁屏保或自己的锁屏图片。", alt: "休眠画面，显示示例书籍封面和已保存的阅读进度" },
];
const lockscreens = [
  { file: "01-own-books.png", title: "读自己的书。", alt: "黑白书页交叠展开，配文：读自己的书。" },
  { file: "02-keep-reading.png", title: "接着读下去。", alt: "书中垂下的纸带连接山川与海岸，配文：接着读下去。" },
  { file: "03-one-page.png", title: "把时间留给一页书。", alt: "阳光在翻起的书页上投下阴影，竖排文字：把时间留给一页书。" },
  { file: "04-offline.png", title: "暂时离线，进入书中。", alt: "打开的书中浮现门廊与阶梯，配文：暂时离线，进入书中。" },
  { file: "05-next-page.png", title: "下一页，自有天地。", alt: "书页旋转展开，配以 Pico Page 字样和文字：下一页，自有天地。" },
];
---
<Site title="Pico Page · 读自己的书，接着读下去" description="Pico Page，为 Read Pico 设计的墨水屏阅读固件。离线阅读 TF 卡上的 EPUB 和 TXT，与 KOReader 接续同一本 EPUB 的阅读位置。书籍、进度和设置，以本地文件保存。" current="home">
  <section class="hero">
    <div class="hero-copy">
      <p class="lede">为 Read Pico 4.7 英寸墨水屏设计的阅读固件</p>
      <h1>读自己的书，<br>接着读下去。</h1>
      <p class="summary">离线阅读 TF 卡上的 EPUB 和 TXT。<br>与 KOReader 接续同一本 EPUB 的阅读位置。</p>
      <p class="actions"><a class="primary" href="#start">三步开始使用 <span aria-hidden="true">↓</span></a><a href="/docs/">阅读完整文档</a></p>
    </div>
    <figure>
      <div class="hero-screens">
        <img src="/assets/screens/library.webp" width="684" height="1216" alt="书库卡片视图，显示示例书籍" decoding="async">
        <img src="/assets/screens/reading.webp" width="684" height="1216" alt="示例书籍正文与阅读进度" fetchpriority="high">
      </div>
      <figcaption>固件界面预览 · 演示数据 · 非设备实拍</figcaption>
    </figure>
  </section>

  <section id="start" class="band">
    <a id="install"></a>
    <div class="heading-row">
      <div>
        <p class="eyebrow">开始使用</p>
        <h2>三步，读上第一本书。</h2>
      </div>
      <p class="needs">需要：Read Pico 一台、FAT 格式的 TF 卡一张、支持数据传输的 USB 线、装有 Chrome 或 Edge 的电脑。</p>
    </div>
    <ol class="start-steps">
      <li>
        <div class="step-head"><span class="numeral">1</span><span>电脑 · 浏览器</span></div>
        <h3>安装固件</h3>
        <p>用 USB 线连接电脑，在浏览器中写入 Pico Page。整片覆盖安装，原厂系统或其他固件都可以直接装；启用了闪存加密或安全启动的设备除外。TF 卡上的书不受影响。</p>
        {firmware ? (
          <p class="outcome"><span class="muted">完成标志</span>　设备重启后显示书库。</p>
        ) : (
          <p class="outcome">网页安装尚未开放。项目仍在开发中，开放后在安装页写入。</p>
        )}
        <a class="primary spread" href="/install/">{firmware ? "打开安装页" : "查看安装步骤"} <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <div class="step-head"><span class="numeral">2</span><span>TF 卡 · 电脑</span></div>
        <h3>放入书和字体</h3>
        <p>把 EPUB、TXT 放进 <code>Books/</code>，把中文字体和许可证放进 <code>Fonts/</code>。</p>
        <div class="tree">
          <div class="muted">TF 卡/</div>
          <div><span>├─ <strong>Books/</strong></span><span>EPUB · TXT</span></div>
          <div class="accent"><span>└─ <strong>Fonts/</strong></span><span>强烈建议</span></div>
        </div>
        <p class="aside">内置字体只有 3,500 个常用汉字，其余字符显示为方框。<a href="#fonts">先下载一款字体 ↓</a></p>
      </li>
      <li>
        <div class="step-head"><span class="numeral">3</span><span>设备</span></div>
        <h3>打开书，选字体</h3>
        <p>把 TF 卡插回设备并重启（长按电源键，选「重启」），在书库里打开一本书。轻点正文中部 → 「排版」 → 选择你放入的字体。离线说明在「设置 → 使用说明」。</p>
        <div class="keys" aria-label="默认按键">
          <div><kbd>K1</kbd><span>上一页</span></div>
          <div><kbd>K2</kbd><span>全刷</span></div>
          <div><kbd>K3</kbd><span>下一页</span></div>
        </div>
      </li>
    </ol>
    <p class="footnote">不想拔卡？在设备上开启 USB 文件传输，同样可以放入书和字体。只传书时，也可以用 Wi‑Fi 传书（设备热点或已保存的 Wi‑Fi）从浏览器上传；字体不能经 Wi‑Fi 上传。<a href="/docs/#transfer">传书方式详解</a></p>
  </section>

  <section id="fonts" class="band">
    <a id="resources"></a>
    <div class="font-layout">
      <div>
        <p class="eyebrow">字体</p>
        <h2>放一款完整的中文字体。</h2>
        <p class="lead">TF 卡上没有字体时，正文使用内置字体。内置字体只包含 3,500 个常用汉字，书里出现其他字符时会显示为方框。放入一款完整的中文字体，就能正常显示。</p>
        <div class="compare">
          <div>
            <p>仅内置字体</p>
            <p class="sample" role="img" aria-label="鄱阳湖畔䶮行，其中「鄱」「䶮」两个字显示为方框"><span class="tofu"></span>阳湖畔<span class="tofu"></span>行</p>
          </div>
          <div>
            <p>放入霞鹜文楷</p>
            <p class="sample wenkai">鄱阳湖畔䶮行</p>
          </div>
        </div>
        <p class="note">示意，缺字位置因书而异。</p>
      </div>
      <div class="font-card">
        <p class="note">推荐字体</p>
        <h3 class="wenkai">霞鹜文楷 Regular</h3>
        <p class="wenkai specimen">读自己的书，接着读下去。</p>
        <p class="credit">v1.520 · 作者 <a href="https://github.com/lxgw/LxgwWenKai/releases/tag/v1.520">LXGW</a> · SIL Open Font License 1.1</p>
        <a class="primary spread" href="/downloads/LXGWWenKai-Regular-v1.520.zip" download>下载字体包（ZIP） <span aria-hidden="true">↓</span></a>
        <ol class="numbered">
          <li><span>1</span><span>解压，把字体文件和许可证复制到 TF 卡的 <code>Fonts/</code>。</span></li>
          <li><span>2</span><span>打开一本书，轻点正文中部，在「排版」中选择该字体。</span></li>
        </ol>
        <p class="own">也可以放入自己的 TTF / OTF 字体，记得附上许可证。<a href="/downloads/LXGWWenKai-v1.520-OFL.txt">查看许可证</a></p>
        <a class="more" href="#lockscreens"><span>另有 5 张锁屏图片，684 × 1216，可在休眠时显示。</span><span>查看锁屏 ↓</span></a>
      </div>
    </div>
  </section>

  <section id="features" class="band">
    <p class="eyebrow">功能</p>
    <h2>书和进度，都由你保管。</h2>
    <p class="lead muted">书籍、阅读进度与设置保存在 TF 卡上。连接电脑，就能查看、备份和整理。</p>
    <div class="features">
      <article>
        <h3>原书直接读</h3>
        <p>EPUB 和 TXT 无需预先转换。目录、书签和书内链接帮你找到内容，长按插图可单独查看。</p>
      </article>
      <article>
        <h3>换设备，接着读</h3>
        <p>同一份 EPUB、同一个同步账户，与 KOReader 接续阅读位置。检查、采用、上传都由你决定。</p>
      </article>
      <article>
        <h3>按你的习惯排版</h3>
        <p>字体、字号、行距和页边距，预览后再应用。每本书可保留不同设置。三档刷新模式按需选择。</p>
      </article>
      <article>
        <h3>两种方式传书</h3>
        <p>USB 文件传输，或经设备热点、已保存的 Wi‑Fi 用浏览器上传。Wi‑Fi 上传的单个文件最大 64 MiB，同名文件不覆盖。</p>
      </article>
    </div>
    <details>
      <summary>格式与功能限制</summary>
      <ul>
        <li>支持 EPUB，以及 UTF-8、GB18030 编码的 TXT。暂不支持 PDF、批注、高亮和词典。</li>
        <li>移动书籍时，把原书旁同名的 <code>.picopage/</code> 目录一起移动，进度和单书设置才会跟随。</li>
        <li>KOReader 位置接续仅支持 EPUB；超出精确定位范围时，不提供跳转。TXT 仅保存本地进度。</li>
        <li>EPUB 使用统一正文排版。表格与复杂版式可能简化显示；不支持的内容可能无法打开。</li>
      </ul>
    </details>
  </section>

  <section id="screens" class="band">
    <p class="eyebrow">界面</p>
    <h2>从打开一本书，到下一页。</h2>
    <ol class="screens">
      {screens.map((screen, index) => (
        <li>
          <img src={`/assets/screens/${screen.id}.webp`} width="684" height="1216" alt={screen.alt} loading="lazy" decoding="async">
          <p class="screen-title"><span class="mono muted">0{index + 1}</span><strong>{screen.title}</strong></p>
          <p>{screen.description}</p>
        </li>
      ))}
    </ol>
    <p class="note">固件界面预览 · 演示数据 · 非设备实拍</p>
    <dl id="devices" class="specs">
      <div><dt>屏幕</dt><dd>4.7 英寸 · 684 × 1216</dd></div>
      <div><dt>灰阶</dt><dd>16 级</dd></div>
      <div><dt>操作</dt><dd>触摸屏 + 三个触摸键</dd></div>
      <div><dt>存储</dt><dd>TF 卡</dd></div>
    </dl>
  </section>

  <section id="lockscreens" class="band">
    <div class="heading-row">
      <div>
        <p class="eyebrow">锁屏</p>
        <h2>锁屏图集 01</h2>
        <p class="note">五张关于书与阅读的图文 · 684 × 1216 · 16 级灰度 · PNG</p>
      </div>
      <a class="primary" href="/downloads/PicoPage-LockScreens-01.zip" download>下载全部（ZIP） <span aria-hidden="true">↓</span></a>
    </div>
    <div class="lockscreens">
      {lockscreens.map((art) => (
        <figure>
          <a href={`/downloads/lockscreens/${art.file}`} aria-label={`查看原图：${art.title}`}>
            <img src={`/downloads/lockscreens/${art.file}`} width="684" height="1216" alt={art.alt} loading="lazy" decoding="async">
          </a>
          <figcaption><strong>{art.title}</strong><a href={`/downloads/lockscreens/${art.file}`} download aria-label={`下载 PNG：${art.title}`}>下载 PNG <span aria-hidden="true">↓</span></a></figcaption>
        </figure>
      ))}
    </div>
    <ol class="numbered usage">
      <li><span>1</span><span>把 <code>LockScreens/</code> 复制到 TF 卡根目录，已有同名文件夹时合并。单张下载的 PNG 也放进这个文件夹。</span></li>
      <li><span>2</span><span>「设置 → 电源与休眠」选「自定义图片」，在「选择图片 / 轮播」中固定一张或选择轮播。</span></li>
      <li><span>3</span><span>点击「保存设置」，让设备空闲片刻等待图片准备完成；未准备好时显示简洁屏保。</span></li>
    </ol>
  </section>
</Site>
<style>
  /* The sample holds only the characters that the .wenkai elements below set; see tools/setup_web_font_sample.py. */
  @font-face {
    font-family: "Pico Page WenKai Sample";
    src: url("/assets/fonts/PicoPageWenKaiSample.woff") format("woff");
    font-display: swap;
  }
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 24px;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  h2 {
    margin-top: 10px;
    font-family: var(--serif);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }
  figcaption,
  .note {
    font-size: 12px;
    color: var(--muted);
  }
  .band {
    border-top: 1px solid var(--ink);
    padding: 64px 0 72px;
  }
  .primary {
    gap: 18px;
    padding: 0 24px;
  }
  .primary.spread {
    display: flex;
    justify-content: space-between;
    padding: 0 18px;
  }
  .heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px 40px;
  }
  .lead {
    max-width: 32em;
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.85;
    color: var(--text);
    text-wrap: pretty;
  }
  .lead.muted {
    color: var(--muted);
  }
  .wenkai {
    font-family: "Pico Page WenKai Sample", "LXGW WenKai", "Kaiti SC", "STKaiti", "KaiTi", serif;
  }

  /* Hero */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 64px;
    padding: clamp(48px, 7vw, 80px) 0 48px;
  }
  .hero-copy {
    flex: 1 1 420px;
    min-width: 0;
  }
  .lede {
    margin-bottom: 22px;
    font-size: 13px;
    color: var(--muted);
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(38px, 5.2vw, 62px);
    font-weight: 700;
    line-height: 1.22;
    text-wrap: balance;
  }
  .summary {
    max-width: 30em;
    margin-top: 22px;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.8;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 34px;
    font-size: 15px;
  }
  .hero figure {
    flex: 0 1 400px;
    min-width: 0;
    margin-left: auto;
  }
  .hero-screens {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 16px;
  }
  .hero-screens img,
  .screens img {
    border: 1px solid var(--ink);
    background: #fff;
  }
  .hero-screens img:first-child {
    margin-bottom: 48px;
  }
  .hero figcaption {
    margin-top: 14px;
  }

  /* Start */
  .needs {
    max-width: 28em;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text);
  }
  .start-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin-top: 40px;
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }
  .start-steps li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 26px 26px 28px;
  }
  .step-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
  }
  .numeral {
    font-family: var(--serif);
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
  }
  .start-steps h3 {
    font-size: 21px;
    font-weight: 600;
  }
  .start-steps p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text);
    text-wrap: pretty;
  }
  .start-steps .outcome {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding-top: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink);
  }
  .tree {
    border: 1px solid var(--line);
    padding: 12px 14px;
    background: #fbfaf7;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.9;
  }
  .tree div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .tree strong {
    font-weight: 500;
  }
  .tree span + span {
    font-family: var(--sans);
    font-size: 12px;
  }
  .start-steps .aside {
    border-left: 2px solid var(--accent);
    padding-left: 12px;
    font-size: 14px;
    line-height: 1.7;
  }
  .keys {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: auto;
  }
  .keys div {
    display: grid;
    gap: 2px;
    border: 1px solid var(--ink);
    padding: 10px 12px;
    font-size: 13px;
  }
  kbd {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 500;
  }
  .footnote {
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }

  /* Fonts */
  .font-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
  }
  .font-layout > div {
    flex: 1 1 380px;
    min-width: 0;
  }
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 440px;
    margin-top: 28px;
  }
  .compare div {
    border: 1px solid var(--line);
    padding: 14px 16px;
    background: #fbfaf7;
    font-size: 12px;
    color: var(--muted);
  }
  .compare div + div {
    border-color: var(--ink);
    background: #fff;
  }
  .compare .sample {
    margin-top: 8px;
    font-family: var(--serif);
    font-size: clamp(16px, 4.6vw, 22px);
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--ink);
  }
  .compare .sample.wenkai {
    font-family: "Pico Page WenKai Sample", "LXGW WenKai", "Kaiti SC", "STKaiti", "KaiTi", serif;
  }
  .tofu {
    display: inline-block;
    width: 0.9em;
    height: 1em;
    margin: 0 1px;
    border: 1px solid var(--ink);
    vertical-align: -0.12em;
  }
  .compare + .note {
    margin-top: 10px;
  }
  .font-layout .font-card {
    flex-basis: 420px;
    border: 1px solid var(--ink);
    padding: 28px;
    background: #fff;
  }
  .font-card h3 {
    margin-top: 6px;
    font-size: 28px;
    font-weight: 400;
  }
  .specimen {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
  }
  .credit {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  .font-card .primary {
    min-height: 50px;
    margin-top: 22px;
  }
