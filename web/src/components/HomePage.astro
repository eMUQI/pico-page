---
const screens = [
  { id: "library", title: "书库", description: "书籍与文件夹，一目了然。列表和封面卡片，按习惯切换。", alt: "书库卡片视图，显示示例书籍与继续阅读入口" },
  { id: "reading", title: "正文", description: "按键或轻点屏幕两侧翻页，底部随时查看阅读进度。", alt: "示例书籍正文，底部显示阅读进度和电量" },
  { id: "tools", title: "阅读工具", description: "轻点正文中部，打开目录、排版、同步与刷新工具。", alt: "正文上的阅读工具，包含目录、排版、同步和刷新入口" },
  { id: "typography", title: "排版", description: "字体、字号与行距，先看预览，再应用到正文。", alt: "示例书籍的排版预览，字号尚未应用" },
  { id: "sync", title: "位置接续", description: "检查远端位置后，选择继续阅读的位置；上传前确认。", alt: "示例书籍的同步面板，分别显示本机与远端阅读位置" },
  { id: "sleep", title: "休眠", description: "暂停阅读，让书籍封面留在屏幕上。也可保留正文、使用简洁屏保，或选择自己的锁屏图片。", alt: "休眠画面，显示示例书籍封面和已保存的阅读进度" },
];
const lockscreens = [
  { file: "01-own-books.png", title: "读自己的书。", alt: "黑白书页交叠展开，配文：读自己的书。" },
  { file: "02-keep-reading.png", title: "接着读下去。", alt: "书中垂下的纸带连接山川与海岸，配文：接着读下去。" },
  { file: "03-one-page.png", title: "把时间留给一页书。", alt: "阳光在翻起的书页上投下阴影，竖排文字：把时间留给一页书。" },
  { file: "04-offline.png", title: "暂时离线，进入书中。", alt: "打开的书中浮现门廊与阶梯，配文：暂时离线，进入书中。" },
  { file: "05-next-page.png", title: "下一页，自有天地。", alt: "书页旋转展开，配以 Pico Page 字样和文字：下一页，自有天地。" },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f3f3f0">
    <meta name="description" content="Pico Page，为 Read Pico 设计的墨水屏阅读固件。离线阅读 TF 卡上的 EPUB 和 TXT，与 KOReader 接续同一本 EPUB 的阅读位置。书籍、进度和设置，以本地文件保存。">
    <title>Pico Page · 读自己的书，接着读下去</title>
    <link rel="stylesheet" href="./assets/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header wrap">
      <a class="wordmark" href="./" aria-label="Pico Page 首页">Pico Page<span class="brand-period">.</span></a>
      <nav aria-label="主导航">
        <a href="#features">功能</a><a href="#screens">界面</a><a href="#devices">设备</a><a href="#install">安装</a><a class="resource-nav" href="#resources">下载</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">READ PICO · 阅读固件</p>
          <h1 id="hero-title">读自己的书，<br>接着读下去。</h1>
          <p class="hero-description">离线阅读 TF 卡上的 EPUB 和 TXT。<br>与 KOReader 接续同一本 EPUB 的阅读位置。</p>
          <div class="actions">
            <a class="button primary" href="#install">安装状态 <span aria-hidden="true">↗</span></a><a class="text-link" href="#screens">浏览界面 <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-footnote">为 Read Pico 设计 · 4.7 英寸墨水屏</p>
        </div>
        <figure class="hero-figure">
          <div class="hero-screens">
            <img class="screen back" src="./assets/screens/library.png" width="684" height="1216" alt="书库卡片视图，显示示例书籍" decoding="async">
            <img class="screen front" src="./assets/screens/reading.png" width="684" height="1216" alt="示例书籍正文与阅读进度" fetchpriority="high">
          </div>
          <figcaption>固件界面预览 · 演示数据 · 非设备实拍</figcaption>
        </figure>
      </section>
      <div class="intro-strip wrap" aria-label="阅读方式">
        <p><span>01 / 离线阅读</span><strong>原书直接打开</strong></p>
        <p><span>02 / 本地文件</span><strong>书和进度由你保管</strong></p>
        <p><span>03 / 位置接续</span><strong>换设备，接着读</strong></p>
      </div>
      <section id="features" class="features" aria-labelledby="features-title">
        <div class="wrap">
          <p class="eyebrow">阅读，从自己的书开始</p>
          <h2 id="features-title">书和进度，都由你保管。</h2>
          <p class="section-lead">书籍、阅读进度与设置保存在 TF 卡上。连接电脑，就能查看、备份和整理。</p>
          <div class="feature-grid">
            <article><span class="feature-number" aria-hidden="true">01</span><h3>原书直接读</h3><p>把 EPUB 或 TXT 放进书库，无需预先转换。用目录、书签和书内链接找到想读的内容，长按插图可单独查看。</p></article>
            <article><span class="feature-number" aria-hidden="true">02</span><h3>换设备，接着读</h3><p>使用同一份 EPUB 和同一个同步账户，与 KOReader 接续阅读位置。何时检查、采用哪个位置、是否上传，都由你决定。</p><p class="feature-note">无法精确定位时，保留本机阅读位置。TXT 仅保存本地进度。</p></article>
            <article><span class="feature-number" aria-hidden="true">03</span><h3>按你的习惯排版</h3><p>选择字体、字号、行距和页边距，预览后再应用。可以放入自己的字体，也可以为每本书保留不同的设置。</p><p class="feature-note">清晰、均衡、快速三档刷新模式，按阅读需要选择。</p></article>
            <article><span class="feature-number" aria-hidden="true">04</span><h3>传书，选顺手的方式</h3><p>在设备上开启 USB 文件传输，用电脑直接管理 TF 卡。也可以开启 Wi-Fi 传书，用手机或电脑的浏览器上传。</p></article>
          </div>
          <details class="limits">
            <summary>格式与功能限制</summary>
            <ul><li>支持 EPUB，以及 UTF-8、GB18030 编码的 TXT。暂不支持 PDF、批注、高亮和词典。</li><li>KOReader 位置接续仅支持 EPUB；超出精确定位范围时，不提供跳转。</li><li>EPUB 使用统一正文排版。表格与复杂版式可能简化显示；不支持的内容可能无法打开。</li></ul>
          </details>
        </div>
      </section>
      <section id="screens" class="screens wrap" aria-labelledby="screens-title">
        <p class="eyebrow">看看日常阅读的样子</p>
        <h2 id="screens-title">从打开一本书，到下一页。</h2>
        <p class="section-lead">黑白灰的界面，把正文放在前面，把常用工具放在手边。</p>
        <div class="screens-layout">
          <div class="screen-index" role="group" aria-label="选择界面预览">
            {screens.map((screen, index) => (
              <button type="button" aria-pressed={index === 0 ? "true" : "false"} aria-controls="screen-display" data-screen={screen.id} data-alt={screen.alt} data-description={screen.description}><strong>{screen.title}</strong><span>{screen.description}</span></button>
            ))}
          </div>
          <figure id="screen-display" class="screen-stage">
            <p id="screen-description" class="screen-description" aria-live="polite">{screens[0].description}</p>
            <img id="screen-preview" class="screen" src="./assets/screens/library.png" width="684" height="1216" alt={screens[0].alt} loading="lazy" decoding="async">
            <figcaption>固件界面预览 · 演示数据 · 非设备实拍</figcaption>
          </figure>
        </div>
        <div class="reading-controls">
          <p>翻页用按键，工具用触摸。</p>
          <div class="keys" aria-label="默认按键"><div><kbd>K1</kbd><span>上一页</span></div><div><kbd>K2</kbd><span>全刷当前画面</span></div><div><kbd>K3</kbd><span>下一页</span></div></div>
          <p class="keys-note">轻点正文中部打开工具。有残影时，按 K2 全刷；所有可交互页面都可使用。</p>
        </div>
      </section>
      <section id="devices" class="hardware wrap" aria-labelledby="devices-title">
        <div class="hardware-heading"><div><p class="eyebrow">支持的设备</p><h2 id="devices-title">为 Read Pico 而做。</h2></div><p class="section-lead">4.7 英寸墨水屏，触摸与按键操作。<br>把日常阅读，装进一块小屏幕。</p></div>
        <dl class="specs">
          <div><dt>屏幕</dt><dd>4.7 英寸</dd><dd class="spec-detail">684 × 1216，竖屏阅读</dd></div>
          <div><dt>灰阶</dt><dd>16 级</dd><dd class="spec-detail">呈现文字、封面与插图</dd></div>
          <div><dt>操作</dt><dd>触摸 + 按键</dd><dd class="spec-detail">触摸屏与三个电容触摸键</dd></div>
          <div><dt>存储</dt><dd>TF 卡</dd><dd class="spec-detail">书籍、进度与设置的本地存储</dd></div>
        </dl>
      </section>
      <section id="install" class="install" aria-labelledby="install-title">
        <div class="wrap install-layout">
          <div>
            <p class="eyebrow">开始使用 PICO PAGE</p><h2 id="install-title">准备好下一本书。</h2>
            <p class="section-lead">准备一台 Read Pico、一张 TF 卡，<br>以及一根支持数据传输的 USB 线。</p>
            <!-- TODO: 正式发布前接入经过验证的浏览器安装入口，并核对设备型号与固件写入范围。 -->
            <div class="actions"><button class="button" type="button" disabled>在浏览器中安装 <span aria-hidden="true">↗</span></button></div>
            <p class="pending">项目仍在开发中，源码与固件暂未公开，尚未提供安装入口。</p>
          </div>
          <ol class="steps"><li><strong>连接设备</strong><span>用 USB 数据线将 Read Pico 连接到电脑。</span></li><li><strong>安装固件</strong><span>待固件发布后，按安装说明核对设备分区与恢复方案。</span></li><li><strong>放入书籍</strong><span>把 EPUB 或 TXT 放进 TF 卡的 <code>Books/</code> 文件夹，即可开始阅读。</span></li></ol>
        </div>
      </section>
      <section id="resources" class="resources wrap" aria-labelledby="resources-title">
        <p class="eyebrow">给阅读，多一点自己的选择</p>
        <h2 id="resources-title">字体与锁屏，随你选择。</h2>
        <p class="section-lead">下载后放进 TF 卡，在设备上选择使用。</p>
        <div id="lockscreens" class="resource-block" aria-labelledby="lockscreens-title">
          <div class="resource-heading">
            <div><h3 id="lockscreens-title">锁屏图集 01</h3><p class="section-lead">五张关于书与阅读的图文。684 × 1216 · 16 级灰度 · PNG</p></div>
            <a class="button" href="./downloads/PicoPage-LockScreens-01.zip" download>下载全部（ZIP）</a>
          </div>
          <div class="lockscreen-grid">
            {lockscreens.map((art) => (
              <figure>
                <a class="lockscreen-preview" href={`./downloads/lockscreens/${art.file}`} aria-label={`预览原图：${art.title}`}>
                  <img src={`./downloads/lockscreens/${art.file}`} width="684" height="1216" alt={art.alt} loading="lazy" decoding="async">
                </a>
                <figcaption><strong>{art.title}</strong><a href={`./downloads/lockscreens/${art.file}`} download aria-label={`下载 PNG：${art.title}`}>下载 PNG <span aria-hidden="true">↓</span></a></figcaption>
              </figure>
            ))}
          </div>
          <p class="section-lead">点击图片查看原图。预览为下载文件，非设备实拍。</p>
          <details class="resource-instructions" open>
            <summary>如何使用锁屏图片</summary>
            <p>需要支持「自定义图片」的固件。解压后，将 <code>LockScreens/</code> 文件夹复制到 TF 卡根目录；已有同名文件夹时合并内容。单张下载的 PNG 也直接放在这个文件夹中。</p>
            <p>在「设置 → 电源与休眠」选择「自定义图片」，进入「选择图片 / 轮播」，选好后返回并点击「保存设置」。可固定一张，也可按文件名顺序轮播。</p>
            <p>保存后让设备空闲片刻，等待图片准备完成；未准备好时会显示简洁屏保。</p>
          </details>
        </div>
        <div id="fonts" class="resource-block font-download" aria-labelledby="fonts-title">
          <h3 id="fonts-title">下载霞鹜文楷</h3>
          <p class="section-lead">官方原版 Regular · v1.520 · 作者 <a href="https://github.com/lxgw">LXGW</a>。按 SIL Open Font License 1.1 免费分发，下载包内附完整许可证与来源说明。</p>
          <div class="actions">
            <a class="button" href="./downloads/LXGWWenKai-Regular-v1.520.zip" download>下载字体包（ZIP）</a>
            <a class="text-link" href="./downloads/LXGWWenKai-v1.520-OFL.txt">查看许可证</a>
            <a class="text-link" href="https://github.com/lxgw/LxgwWenKai/releases/tag/v1.520">官方来源</a>
          </div>
          <p class="section-lead">解压后，将字体文件和许可证复制到 TF 卡的 <code>Fonts/</code> 文件夹，再在阅读工具的「排版」中选择该字体。</p>
        </div>
      </section>
    </main>
    <footer class="site-footer wrap">
      <p><span class="footer-brand">Pico Page.</span><span>读自己的书，接着读下去。</span></p>
      <nav aria-label="页脚导航"><a href="https://quotaframe.com">QuotaFrame</a></nav>
    </footer>
    <script is:inline>
      const preview = document.getElementById("screen-preview");
      const description = document.getElementById("screen-description");
      const buttons = document.querySelectorAll(".screen-index button");
      buttons.forEach((button) =>
        button.addEventListener("click", () => {
          buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
          preview.src = `./assets/screens/${button.dataset.screen}.png`;
          preview.alt = button.dataset.alt;
          description.textContent = button.dataset.description;
        }),
      );
    </script>
  </body>
</html>
