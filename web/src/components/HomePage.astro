<script>
  const screenButtons = document.querySelectorAll<HTMLButtonElement>("[data-screen-btn]");
  const stageImg = document.querySelector<HTMLImageElement>('[data-el="stage-img"]');
  const stageKeyEls = document.querySelectorAll<HTMLElement>('[data-el="stage-keys"] [data-key]');

  for (const btn of screenButtons) {
    btn.addEventListener("click", () => {
      if (stageImg && btn.dataset.screenSrc) {
        stageImg.src = btn.dataset.screenSrc;
        stageImg.alt = btn.dataset.screenAlt ?? "";
      }
      const activeKeys = new Set((btn.dataset.screenKeys ?? "").split(",").filter(Boolean));
      for (const keyEl of stageKeyEls) {
        keyEl.classList.toggle("is-active", activeKeys.has(keyEl.dataset.key ?? ""));
      }
      for (const item of screenButtons) {
        const active = item === btn;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      }
    });
  }

  const extraTabs = document.querySelectorAll<HTMLButtonElement>("[data-extra-tab]");
  const extraPanels = document.querySelectorAll<HTMLElement>("[data-extra-panel]");
  const hashToTab: Record<string, string> = {
    "#transparent-lockscreens": "transparent",
    "#historical-seals": "transparent",
    "#lockscreens": "lockscreens",
    "#dictionaries": "dictionaries",
  };

  function activateExtraTab(name: string) {
    for (const tab of extraTabs) {
      const active = tab.dataset.extraTab === name;
      tab.classList.toggle("is-active", active);
      tab.setAttribute("aria-selected", String(active));
    }
    for (const panel of extraPanels) {
      panel.hidden = panel.dataset.extraPanel !== name;
    }
  }

  for (const tab of extraTabs) {
    tab.addEventListener("click", () => {
      if (tab.dataset.extraTab) activateExtraTab(tab.dataset.extraTab);
    });
  }

  function syncExtraTabFromHash() {
    const target = hashToTab[location.hash];
    if (target) activateExtraTab(target);
  }
  syncExtraTabFromHash();
  window.addEventListener("hashchange", syncExtraTabFromHash);

  const sealButtons = document.querySelectorAll<HTMLButtonElement>("[data-seal-select]");
  const sealCards = document.querySelectorAll<HTMLElement>("[data-seal-card]");
  const sealOverlay = document.querySelector<HTMLImageElement>('[data-el="seal-overlay"]');
  const sealCaption = document.querySelector<HTMLElement>('[data-el="seal-caption"]');
  const sealScreen = document.querySelector<HTMLElement>('[data-el="seal-screen"]');
  const sealBgToggle = document.querySelector<HTMLButtonElement>('[data-el="seal-bg-toggle"]');

  for (const btn of sealButtons) {
    btn.addEventListener("click", () => {
      if (sealOverlay && btn.dataset.sealFile) {
        sealOverlay.src = btn.dataset.sealFile;
        sealOverlay.alt = btn.dataset.sealAlt ?? "";
      }
      if (sealCaption && btn.dataset.sealLabel) {
        const template = sealCaption.dataset.template ?? "{value}";
        sealCaption.textContent = template.replace("{value}", btn.dataset.sealLabel);
      }
      const parentCard = btn.closest("[data-seal-card]");
      for (const card of sealCards) {
        card.classList.toggle("is-active", card === parentCard);
      }
      for (const b of sealButtons) {
        b.setAttribute("aria-pressed", String(b === btn));
      }
    });
  }

  sealBgToggle?.addEventListener("click", () => {
    const whiteMode = sealScreen?.classList.toggle("is-white-bg") ?? false;
    sealBgToggle.setAttribute("aria-pressed", String(whiteMode));
  });
</script>

