---
import Site from "../layouts/Site.astro";
import { firmware } from "../firmware.js";
import { items as transparentLockscreens } from "../../public/downloads/transparent-lockscreens/manifest.json";
import copy from "../copy/home.json";
import { defaultLocale, localizeHref, translator } from "../locales.js";

const { locale = defaultLocale } = Astro.props;
const t = translator(locale, copy);

const screens = [
  { id: "library", keys: "k1,k2,k3", title: t("书库"), description: t("书籍与文件夹，一目了然。列表和封面卡片，按习惯切换。"), alt: t("书库卡片视图，显示继续阅读入口和另外两本示例书") },
  { id: "reading", keys: "k1,k2,k3", title: t("正文"), description: t("按键或轻点屏幕两侧翻页，底部随时查看阅读进度。"), alt: t("示例书籍正文，底部显示页码和电量") },
  { id: "tools", keys: "k2", title: t("阅读工具"), description: t("轻点正文中部，打开目录、排版、同步、刷新模式和全刷。"), alt: t("正文上的阅读工具，包含目录、排版、同步、刷新模式和全刷入口") },
  { id: "typography", keys: "k2", title: t("排版"), description: t("字体、字重、字号、行距等设置，先看预览，再应用到这本书。"), alt: t("示例书籍的排版面板，字号改为 40 px，尚未应用") },
  { id: "dictionary", keys: "k1,k2,k3", title: t("查词"), description: t("长按正文选词，释义显示在当前页。可调整选区、切换词典。"), alt: t("示例正文中选中「放晴」，下方显示释义和词典切换控件") },
  { id: "sync", keys: "k2", title: t("位置接续"), description: t("检查远端位置后，选择继续阅读的位置；上传前确认。"), alt: t("示例书籍的同步面板，分别显示本机与远端阅读位置") },
  { id: "sleep", keys: "", title: t("休眠"), description: t("封面、正文、简洁屏保或自己的锁屏图片。"), alt: t("休眠画面，显示示例书籍封面和已保存的阅读进度") },
];
const initialScreen = screens[1];

const lockscreens = [
  { file: "01-own-books.png", title: t("读自己的书。"), alt: t("黑白书页交叠展开，配文：读自己的书。") },
  { file: "02-keep-reading.png", title: t("接着读下去。"), alt: t("书中垂下的纸带连接山川与海岸，配文：接着读下去。") },
  { file: "03-one-page.png", title: t("把时间留给一页书。"), alt: t("阳光在翻起的书页上投下阴影，竖排文字：把时间留给一页书。") },
  { file: "04-offline.png", title: t("暂时离线，进入书中。"), alt: t("打开的书中浮现门廊与阶梯，配文：暂时离线，进入书中。") },
  { file: "05-next-page.png", title: t("下一页，自有天地。"), alt: t("书页旋转展开，配以 Pico Page 字样和文字：下一页，自有天地。") },
];
const dictionaries = [
  { audience: t("读英文书"), title: t("朗道英汉字典 5.0"), entries: "435,468", size: "8.7 MB" },
  { audience: t("读中文书"), title: t("汉语大词典 离线版"), entries: "349,514", size: "73 MB" },
  { audience: t("两种都读"), title: t("21 世纪英汉汉英双向词典"), entries: "213,741", size: "13 MB" },
];
const initialSeal = transparentLockscreens[0];
const sealLabel = (art) =>
  `${t(art.title)} · ${art.author === "Pico Page" ? art.author : t(art.author)}${"year" in art ? t(" · {value} 年").replace("{value}", () => art.year) : ""}`;
---
<Site
  locale={locale}
  title={t("Pico Page · 读自己的书，接着读下去")}
  description={t("Pico Page，为 Read Pico 设计的墨水屏阅读固件。离线阅读 TF 卡上的 EPUB 和 TXT，与 KOReader 接续同一本 EPUB 的阅读位置，长按正文可离线查词。书籍、进度和设置，以本地文件保存。")}
  current="home"
  fullBleed
>
  <section class="hero-band">
    <div class="wrap hero">
      <div class="hero-copy">
        <div class="hero-badge mono">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>{t("为 Read Pico 4.7 英寸墨水屏设计的阅读固件")}</span>
          {firmware && (
            <>
              <span class="badge-sep" aria-hidden="true">|</span>
              <span class="badge-ver">v{firmware.version}</span>
            </>
          )}
        </div>
        <h1>{t("读自己的书，")}<br>{t("接着读下去。")}</h1>
        <p class="summary">{t("离线阅读 TF 卡上的 EPUB 和 TXT。")}<br>{t("与 KOReader 接续同一本 EPUB 的阅读位置。")}</p>
        <div class="actions">
          <a class="primary" href={localizeHref(locale, "/install/")}>
            <span>{firmware ? t("网页安装固件") : t("查看安装步骤")}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="outline" href="#fonts">
            <span>{t("下载必备字体")}</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a class="text-link" href="#start">{t("三步流程")}</a>
          <a class="text-link" href={localizeHref(locale, "/docs/")}>{t("阅读完整文档")}</a>
        </div>
        <p class="hero-meta">
          <span>{firmware ? t("电脑版 Chrome 或 Edge 网页安装") : t("网页安装尚未开放")}</span>
          <span aria-hidden="true">·</span>
          <span>{t("不影响 TF 卡上已有书籍")}</span>
        </p>
      </div>
      <figure class="hero-visual">
        <div class="hero-devices">
          <div class="pico-device hero-back-device">
            <div class="pico-screen">
              <img src="/assets/screens/library.webp" width="684" height="1216" alt={t("书库卡片视图，显示示例书籍")} decoding="async">
            </div>
            <img class="pico-frame" src="/assets/read-pico-frame.webp" width="774" height="1374" alt="" aria-hidden="true" decoding="async">
          </div>
          <div class="pico-device hero-device">
            <div class="pico-screen">
              <img src="/assets/screens/reading.webp" width="684" height="1216" alt={t("示例书籍正文与阅读进度")} fetchpriority="high">
            </div>
            <img class="pico-frame" src="/assets/read-pico-frame.webp" width="774" height="1374" alt="" aria-hidden="true" fetchpriority="high">
          </div>
        </div>
        <figcaption>{t("固件界面预览 · 演示数据 · 非设备实拍")}</figcaption>
      </figure>
    </div>
  </section>

  <section id="start" class="band">
    <a id="install" class="anchor-offset"></a>
    <div class="wrap">
      <div class="heading-row">
        <div>
          <p class="eyebrow">01 / {t("上手必做")}</p>
          <h2>{t("装好固件，再放一款中文字体。")}</h2>
        </div>
        <ul class="prereqs" aria-label={t("需要：Read Pico 一台、FAT 格式的 TF 卡一张、支持数据传输的 USB 线、装有 Chrome 或 Edge 的电脑。")}>
          <li>Read Pico</li>
          <li>{t("FAT 格式 TF 卡")}</li>
          <li>{t("支持数据传输的 USB 线")}</li>
          <li>{t("电脑版 Chrome 或 Edge")}</li>
        </ul>
      </div>

      <ol class="start-steps">
        <li>
          <div class="step-head"><span class="numeral">01</span><span class="mono">{t("电脑 · 浏览器")}</span></div>
          <h3>{t("安装固件")}</h3>
          <p>{t("用 USB 线连接电脑，在浏览器中写入 Pico Page。整片覆盖安装，原厂系统或其他固件都可以直接装；启用了闪存加密或安全启动的设备除外。TF 卡上的书籍、阅读进度和 Pico Page 设置不受影响。")}</p>
          <div class="step-foot">
            {firmware ? (
              <p class="outcome"><span class="muted">{t("完成标志")}</span>　{t("设备重启后显示书库。")}</p>
            ) : (
              <p class="outcome">{t("网页安装尚未开放。项目仍在开发中，开放后在安装页写入。")}</p>
            )}
            <a class="primary spread" href={localizeHref(locale, "/install/")}>
              <span>{firmware ? t("打开安装页") : t("查看安装步骤")}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </li>

        <li>
          <div class="step-head"><span class="numeral">02</span><span class="mono">{t("TF 卡 · 必备")}</span></div>
          <h3>{t("放入书和字体")}</h3>
          <p>{t("把 EPUB、TXT 放进")} <code>Books/</code>{t("，把中文字体放进")} <code>Fonts/</code>{t("。")}</p>
          <div class="tree">
            <div class="muted">{t("TF 卡/")}</div>
            <div><span>├─ <strong>Books/</strong></span><span>EPUB · TXT</span></div>
            <div class="accent"><span>└─ <strong>Fonts/</strong></span><span>{t("强烈建议")}</span></div>
          </div>
          <p class="aside">{t("内置字体只有 3,500 个常用汉字，其余字符显示为方框。")}<a href="#fonts">{t("下方直接下载 ↓")}</a></p>
        </li>

        <li>
          <div class="step-head"><span class="numeral">03</span><span class="mono">{t("设备")}</span></div>
          <h3>{t("打开书，选字体")}</h3>
          <p>{t("把 TF 卡插回设备并重启（长按电源键，选「重启」），在书库里打开一本书。轻点正文中部 → 「排版」 → 选择你放入的字体。离线说明在「设置 → 使用说明」。")}</p>
          <div class="keys" aria-label={t("默认按键")}>
            <div><kbd>K1</kbd><span>{t("上一页")}</span></div>
            <div><kbd>K2</kbd><span>{t("全刷")}</span></div>
            <div><kbd>K3</kbd><span>{t("下一页")}</span></div>
          </div>
        </li>
      </ol>

      <p class="footnote">
        {t("不想拔卡？在设备上开启 USB 文件传输，同样可以放入书和字体。也可以用 Wi‑Fi 传书（设备热点或已保存的 Wi‑Fi）从浏览器上传书；固件 0.2.0-beta.3 起，同一页面还能上传字体和锁屏图片，更早的版本只能传书。")}
        <a href={localizeHref(locale, "/docs/#transfer")}>{t("传书方式详解")}</a>
      </p>

      <a id="resources" class="anchor-offset"></a>
      <div id="fonts" class="font-panel">
        <div class="font-explain">
          <div>
            <p class="font-tag mono">{t("必备配套 · 对应第 2 步")}</p>
            <h3>{t("放一款完整的中文字体。")}</h3>
            <p class="lead">{t("TF 卡上没有字体时，正文使用内置字体。内置字体只包含 3,500 个常用汉字，书里出现其他字符时会显示为方框。放入一款完整的中文字体，就能正常显示。")}</p>
          </div>
          <div>
            <div class="compare">
              <div>
                <p>{t("仅内置字体")}</p>
                <p class="sample" role="img" aria-label={t("鄱阳湖畔䶮行，其中「鄱」「䶮」两个字显示为方框")}><span lang="zh-Hans"><span class="tofu"></span>阳湖畔<span class="tofu"></span>行</span></p>
              </div>
              <div class="compare-good">
                <p>{t("放入霞鹜文楷")}</p>
                <p class="sample wenkai" lang="zh-Hans">鄱阳湖畔䶮行</p>
              </div>
            </div>
            <p class="note">{t("示意，缺字位置因书而异。")}</p>
          </div>
        </div>

        <div class="font-card">
          <div>
            <div class="font-card-meta">
              <span>{t("推荐字体")}</span>
              <span class="mono">v1.520 · SIL OFL 1.1</span>
            </div>
            <h4 class="wenkai">{t("霞鹜文楷 Regular")}</h4>
            <div class="specimen-box">
              <p class="wenkai specimen" lang="zh-Hans">读自己的书，接着读下去。</p>
              <p class="credit">{t("v1.520 · 作者")} <a href="https://github.com/lxgw/LxgwWenKai/releases/tag/v1.520" target="_blank" rel="noopener">LXGW</a> · <a href="/downloads/LXGWWenKai-v1.520-OFL.txt">SIL Open Font License 1.1</a></p>
            </div>
          </div>
          <div class="font-card-actions">
            <a class="accent-button spread" href="/downloads/LXGWWenKai-Regular-v1.520.zip" download>
              <span>{t("下载字体包（ZIP）")}</span>
              <span aria-hidden="true">↓</span>
            </a>
            <p class="own">{t("解压，把字体文件复制到 TF 卡的")} <code>Fonts/</code>{t("。")} {t("也可以放入自己的 TTF / OTF 字体。")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="band band-tray">
    <div class="wrap">
      <div class="heading-row">
        <div>
          <p class="eyebrow">02 / {t("核心体验与界面")}</p>
          <h2>{t("从打开一本书，到下一页。")}</h2>
        </div>
        <p class="needs">{t("书籍、阅读进度与设置保存在 TF 卡上。点击下方场景，在模拟屏幕上查看各处日常交互。")}</p>
      </div>

      <div class="features">
        <article>
          <h3>{t("原书直接读")}</h3>
          <p>{t("EPUB 和 TXT 无需预先转换。目录、书签和书内链接帮你找到内容，长按插图可单独查看。")}</p>
        </article>
        <article>
          <h3>{t("按你的习惯排版")}</h3>
          <p>{t("字体、字号、行距和页边距，预览后再应用。每本书可保留不同设置。三档刷新模式按需选择。")}</p>
        </article>
        <article>
          <h3>{t("长按就地查词")}</h3>
          <p>{t("0.5.0 起支持离线 StarDict 词典。长按正文选词，释义显示在当前页，可随时切换词典。")}</p>
        </article>
        <article>
          <h3>{t("换设备，接着读")}</h3>
          <p>{t("同一份 EPUB、同一个同步账户，与 KOReader 接续阅读位置。检查、采用、上传都由你决定。")}</p>
        </article>
      </div>

      <div id="screens" class="stage-card">
        <div class="stage-list-col">
          <p class="stage-label mono">{t("点击切换固件界面")}</p>
          <ol class="screen-switcher">
            {screens.map((screen, index) => {
              const active = screen.id === initialScreen.id;
              return (
                <li>
                  <button
                    type="button"
                    class:list={["screen-item", active && "is-active"]}
                    data-screen-btn
                    data-screen-src={`/assets/screens/${screen.id}.webp`}
                    data-screen-alt={screen.alt}
                    data-screen-keys={screen.keys}
                    aria-pressed={active ? "true" : "false"}
                  >
                    <span class="screen-row-head">
                      <span class="mono accent">0{index + 1}</span>
                      <strong>{screen.title}</strong>
                    </span>
                    <span class="screen-row-desc">{screen.description}</span>
                  </button>
                </li>
              );
            })}
          </ol>
        </div>

        <figure class="stage-device-col">
          <div class="pico-device stage-device">
            <div class="pico-screen">
              <img
                data-el="stage-img"
                src={`/assets/screens/${initialScreen.id}.webp`}
                width="684"
                height="1216"
                alt={initialScreen.alt}
                loading="lazy"
                decoding="async"
              >
            </div>
            <img class="pico-frame" src="/assets/read-pico-frame.webp" width="774" height="1374" alt="" aria-hidden="true" loading="lazy" decoding="async">
          </div>
          <div class="stage-key-bar" data-el="stage-keys" aria-label={t("默认按键")}>
            <span class="stage-key-pill is-active" data-key="k1"><kbd>K1</kbd> {t("上一页")}</span>
            <span class="stage-key-pill is-active" data-key="k2"><kbd>K2</kbd> {t("全刷")}</span>
            <span class="stage-key-pill is-active" data-key="k3"><kbd>K3</kbd> {t("下一页")}</span>
          </div>
          <figcaption>{t("固件界面预览 · 演示数据 · 非设备实拍")}</figcaption>
        </figure>
      </div>

      <div class="colophon-card">
        <dl id="devices" class="specs">
          <div><dt>{t("屏幕")}</dt><dd class="mono">{t("4.7 英寸 · 684 × 1216")}</dd></div>
          <div><dt>{t("灰阶")}</dt><dd>{t("16 级")}</dd></div>
          <div><dt>{t("操作")}</dt><dd>{t("触摸屏 + 三个触摸键")}</dd></div>
          <div><dt>{t("存储")}</dt><dd>{t("TF 卡")}</dd></div>
        </dl>
        <details class="limits-details">
          <summary>{t("格式与功能限制")}</summary>
          <ul>
            <li>{t("支持 EPUB，以及 UTF-8、GB18030 编码的 TXT。暂不支持 PDF、批注和高亮。")}</li>
            <li>{t("移动书籍时，把原书旁同名的")} <code>.picopage/</code> {t("目录一起移动，进度和单书设置才会跟随。")}</li>
            <li>{t("KOReader 位置接续仅支持 EPUB；超出精确定位范围时，不提供跳转。TXT 仅保存本地进度。")}</li>
            <li>{t("EPUB 默认使用原书排版，也可在「排版」中切换到「统一排版」。表格与复杂版式可能简化显示；不支持的内容可能无法打开。")}</li>
            <li>{t("USB 文件传输，或经设备热点、已保存的 Wi‑Fi 用浏览器上传。Wi‑Fi 上传的书籍最大 64 MiB，同名文件不覆盖。")}</li>
          </ul>
        </details>
      </div>
    </div>
  </section>

  <section id="extras" class="band">
    <a id="transparent-lockscreens" class="anchor-offset"></a>
    <a id="historical-seals" class="anchor-offset"></a>
    <a id="lockscreens" class="anchor-offset"></a>
    <a id="dictionaries" class="anchor-offset"></a>
    <div class="wrap">
      <div class="heading-row">
        <div>
          <p class="eyebrow">03 / {t("进阶与个性扩展")}</p>
          <h2>{t("装完之后，按喜好慢慢添置。")}</h2>
        </div>
        <div class="extra-tabs" role="tablist" aria-label={t("扩展资源切换")}>
          <button type="button" role="tab" id="tab-transparent" aria-controls="panel-transparent" aria-selected="true" data-extra-tab="transparent" class="extra-tab is-active">
            {t("透明锁屏")} · {transparentLockscreens.length}
          </button>
          <button type="button" role="tab" id="tab-lockscreens" aria-controls="panel-lockscreens" aria-selected="false" data-extra-tab="lockscreens" class="extra-tab">
            {t("锁屏图集 01")} · {lockscreens.length}
          </button>
          <button type="button" role="tab" id="tab-dictionaries" aria-controls="panel-dictionaries" aria-selected="false" data-extra-tab="dictionaries" class="extra-tab">
            {t("离线词典")}
          </button>
        </div>
      </div>

      <div id="panel-transparent" role="tabpanel" aria-labelledby="tab-transparent" data-extra-panel="transparent" class="extra-panel">
        <div class="transparent-layout">
          <div class="seal-preview-col">
            <div class="pico-device seal-preview-device">
              <div class="pico-screen seal-screen" data-el="seal-screen">
                <img
                  class="seal-underlay"
                  src="/assets/screens/reading.webp"
                  width="684"
                  height="1216"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                >
                <img
                  class="seal-overlay"
                  data-el="seal-overlay"
                  src={`/downloads/transparent-lockscreens/${initialSeal.file}`}
                  width="684"
                  height="1216"
                  alt={t(initialSeal.description)}
                  loading="lazy"
                  decoding="async"
                >
              </div>
              <img class="pico-frame" src="/assets/read-pico-frame.webp" width="774" height="1374" alt="" aria-hidden="true" loading="lazy" decoding="async">
            </div>
            <div class="seal-preview-controls">
              <button
                type="button"
                class="secondary seal-toggle"
                data-el="seal-bg-toggle"
                data-label-reading={t("叠加正文预览")}
                data-label-white={t("纯白底预览")}
                aria-pressed="false"
              >
                {t("切换：叠加正文 / 纯白底")}
              </button>
              <p class="note" data-el="seal-caption" data-template={t("当前预览：{value}")}>
                {t("当前预览：{value}").replace("{value}", () => sealLabel(initialSeal))}
              </p>
            </div>
          </div>

          <div class="seal-gallery-col">
            <div class="sub-head">
              <div>
