---
import "../styles/site.css";
import Analytics from "../components/Analytics.astro";
import { defaultLocale, languagePreferenceKey, locales, localizeHref } from "../locales.js";

const { title, description, current, locale = defaultLocale, noindex = false } = Astro.props;
const copy = {
 "zh-Hans": {
   skip: "跳到正文", brand: "Pico Page 首页", tagline: "阅读固件", docs: "文档", install: "安装固件",
   primaryNav: "主导航", sections: ["开始使用", "字体", "词典", "功能", "界面", "锁屏"],
   languages: "语言", footerNav: "页脚导航", changelog: "更新日志", licenses: "第三方许可", home: "返回首页",
   motto: "读自己的书，接着读下去。",
 },
 "zh-Hant": {
   skip: "跳至正文", brand: "Pico Page 首頁", tagline: "閱讀韌體", docs: "文件", install: "安裝韌體",
   primaryNav: "主導覽", sections: ["開始使用", "字型", "字典", "功能", "介面", "鎖定畫面"],
   languages: "語言", footerNav: "頁尾導覽", changelog: "更新日誌", licenses: "第三方授權", home: "返回首頁",
   motto: "讀自己的書，接著讀下去。",
 },
 en: {
   skip: "Skip to content", brand: "Pico Page home", tagline: "Reading firmware", docs: "Docs", install: "Install firmware",
   primaryNav: "Main navigation", sections: ["Get started", "Fonts", "Dictionaries", "Features", "Interface", "Lock screens"],
   languages: "Language", footerNav: "Footer navigation", changelog: "Changelog", licenses: "Third-party licenses", home: "Back to home",
   motto: "Read your own books. Pick up where you left off.",
 },
}[locale];
const anchors = ["start", "fonts", "dictionaries", "features", "screens", "lockscreens"];
const currentPath = { docs: "/docs/", install: "/install/", changelog: "/changelog/" }[current] ?? "/";
const path = (href) => localizeHref(locale, href);
const localizedPath = (language) => localizeHref(language, currentPath);
const homepagePaths = Object.fromEntries(Object.keys(locales).map((language) => [language, localizeHref(language, "/")]));
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f4ef">
    {current === "home" && locale === defaultLocale &&
      <script define:vars={{ defaultLocale, languagePreferenceKey, homepagePaths }}>
        const current = new URL(location.href);
        let preferred = current.searchParams.get("lang");
        if (!Object.hasOwn(homepagePaths, preferred)) {
          try {
            preferred = localStorage.getItem(languagePreferenceKey);
          } catch {
            preferred = null;
          }
        }
        if (!Object.hasOwn(homepagePaths, preferred)) {
          const browserLocale = navigator.languages?.[0] || navigator.language || defaultLocale;
          const [language, scriptOrRegion] = browserLocale.toLowerCase().split("-");
          preferred = language !== "zh" ? "en" :
            ["hant", "tw", "hk", "mo"].includes(scriptOrRegion) ? "zh-Hant" : defaultLocale;
        }
        if (preferred !== defaultLocale) {
          current.pathname = homepagePaths[preferred];
          location.replace(current.href);
        }
      </script>
    }
    {description && <meta name="description" content={description}>}
    {noindex && <meta name="robots" content="noindex">}
    {!noindex && <link rel="canonical" href={new URL(path(currentPath), Astro.site)}>}
    {!noindex && Object.keys(locales).map((language) => (
      <link rel="alternate" hreflang={language} href={new URL(localizedPath(language), Astro.site)}>
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(currentPath, Astro.site)}>}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <div class="wrap">
      <header class="site-header">
        <div class="bar">
          <a class="brand" href={path("/")} aria-label={copy.brand}>
            <span class="wordmark">Pico Page</span>
            <span class="tagline">Read Pico<br>{copy.tagline}</span>
          </a>
          <div class="bar-links">
            {current === "docs" ? <span class="here" aria-current="page">{copy.docs}</span> : <a class="outline" href={path("/docs/")}>{copy.docs}</a>}
            {current === "install" ? <span class="here" aria-current="page">{copy.install}</span> : <a class="primary" href={path("/install/")}>{copy.install}</a>}
          </div>
        </div>
        <div class="site-navigation">
          <nav aria-label={copy.primaryNav}>
            {anchors.map((anchor, index) => <a href={path(`/#${anchor}`)}>{copy.sections[index]}</a>)}
          </nav>
          <nav class="language-nav" aria-label={copy.languages}>
            {Object.entries(locales).map(([language, { name }]) => language === locale ? (
              <span lang={language} aria-current="true">{name}</span>
            ) : (
              <a href={localizedPath(language)} hreflang={language} lang={language} data-language-link={noindex ? "home" : "same-page"}>{name}</a>
            ))}
          </nav>
        </div>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <p class="wordmark">Pico Page</p>
          <p>{copy.motto}</p>
        </div>
        <nav aria-label={copy.footerNav}>
          {current !== "docs" && <a href={path("/docs/")}>{copy.docs}</a>}
          {current !== "install" && <a href={path("/install/")}>{copy.install}</a>}
          {current !== "changelog" && <a href={path("/changelog/")}>{copy.changelog}</a>}
          <a href="https://github.com/eMUQI/pico-page" target="_blank" rel="noopener">GitHub</a>
          {current === "install" && <a href="/assets/third-party-licenses.txt">{copy.licenses}</a>}
          {current !== "home" && <a href={path("/")}>{copy.home}</a>}
          {current === "home" && <a class="muted" href="https://quotaframe.com" target="_blank" rel="noopener">QuotaFrame</a>}
        </nav>
      </footer>
    </div>
    <Analytics />
  </body>
</html>

<script>
  import { defaultLocale, languagePreferenceKey } from "../locales.js";

  const languageLinks = document.querySelectorAll<HTMLAnchorElement>("[data-language-link]");

  function preserveLanguageLinkLocation() {
    for (const link of languageLinks) {
      if (link.dataset.languageLink !== "same-page") continue;
      const destination = new URL(link.href);
      destination.search = location.search;
      if (destination.searchParams.has("lang")) destination.searchParams.delete("lang");
      destination.hash = location.hash;
      link.href = destination.href;
    }
  }

  for (const link of languageLinks) {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem(languagePreferenceKey, link.hreflang);
      } catch {
        const destination = new URL(link.href);
        if (link.hreflang === defaultLocale && destination.pathname === "/") {
          destination.searchParams.set("lang", defaultLocale);
          link.href = destination.href;
        }
      }
    });
  }

  preserveLanguageLinkLocation();
  window.addEventListener("hashchange", preserveLanguageLinkLocation);
</script>
