---
import "../styles/site.css";

// current names the page the header and footer must not link to: "home", "install" or "docs".
const { title, description, current, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f4ef">
    {description && <meta name="description" content={description}>}
    {noindex && <meta name="robots" content="noindex">}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="wrap">
      <header class="site-header">
        <div class="bar">
          <a class="brand" href="/" aria-label="Pico Page 首页">
            <span class="wordmark">Pico Page</span>
            <span class="tagline">Read Pico<br>阅读固件</span>
          </a>
          <div class="bar-links">
            {current === "docs" ? <span class="here" aria-current="page">文档</span> : <a class="outline" href="/docs/">文档</a>}
            {current === "install" ? <span class="here" aria-current="page">安装固件</span> : <a class="primary" href="/install/">安装固件</a>}
          </div>
        </div>
        <nav aria-label="主导航">
          <a href="/#start">开始使用</a><a href="/#fonts">字体</a><a href="/#features">功能</a><a href="/#screens">界面</a><a href="/#lockscreens">锁屏</a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <p class="wordmark">Pico Page</p>
          <p>读自己的书，接着读下去。</p>
        </div>
        <nav aria-label="页脚导航">
          {current !== "docs" && <a href="/docs/">文档</a>}
          {current !== "install" && <a href="/install/">安装固件</a>}
          {current === "install" && <a href="/assets/third-party-licenses.txt">第三方许可</a>}
          {current !== "home" && <a href="/">返回首页</a>}
          {current === "home" && <a class="muted" href="https://quotaframe.com">QuotaFrame</a>}
        </nav>
      </footer>
    </div>
  </body>
</html>
