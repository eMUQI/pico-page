{
  "$meta": {
    "unit": "device px on 684x1216 portrait",
    "status": "initial values, verify on hardware",
    "gray_index": "16-level, 0 = black, 15 = white"
  },
  "color": {
    "ink":        { "hex": "#111111", "gray_index": 1,  "use": "body text, titles, borders, inverted fill" },
    "secondary":  { "hex": "#333333", "gray_index": 3,  "use": "descriptions, labels" },
    "disabled":   { "hex": "#555555", "gray_index": 5,  "use": "disabled text and dashed borders; always paired with dash/strike/reason" },
    "rule_light": { "hex": "#CFCFCF", "gray_index": 12, "use": "list row separators only; disappears in near-BW" },
    "paper":      { "hex": "#FFFFFF", "gray_index": 15, "use": "background" }
  },
  "font": {
    "body": { "family": "LXGW WenKai", "license": "SIL OFL 1.1", "source": "github.com/lxgw/LxgwWenKai", "weights": [400] },
    "ui":   { "family": "Source Han Sans SC / Noto Sans SC", "license": "SIL OFL 1.1", "source": "Adobe / Google Fonts", "weights": [400, 500, 700] },
    "fallback": ["ui", "firmware built-in UI font (must cover all error-message glyphs)"]
  },
  "type_scale": {
    "chapter_title": 48,
    "body_default": 38,
    "body_range": { "min": 28, "max": 56, "step": 2 },
    "page_title": 34,
    "heading": 32,
    "value_large": 30,
    "label_primary": 28,
    "label": 26,
    "description": 24,
    "auxiliary": 22,
    "tag_min": 20
  },
  "reading": {
    "line_height": { "default": 1.5, "min": 1.35, "max": 1.65, "step": 0.05 },
    "margin_x": { "default": 36, "min": 24, "max": 52, "step": 4 },
    "paragraph_spacing_em": { "default": 0, "min": 0, "max": 1.0, "step": 0.2 },
    "first_line_indent_chars": { "default": 2, "options": [0, 1, 2] },
    "body_top": 64,
    "footer_height": 88
  },
  "space": { "base": 4, "scale": [4, 8, 12, 16, 20, 24, 28, 36, 48] },
  "border": {
    "regular": 2,
    "emphasis": 3,
    "pressed": 6,
    "dashed": { "width": 2, "use": "disabled, pending, unsaved, missing" }
  },
  "radius": 0,
  "size": {
    "top_bar": 104,
    "tab_bar": 96,
    "button": 96,
    "list_row_min": 88,
    "library_row": 116,
    "toc_row": 86,
    "stepper_button": [120, 88],
    "toggle_segment": [64, 60],
    "pager_button": [180, 88],
    "tool_entry_row": 136,
    "icon_visual": 40
  },
  "touch_zones_reading": {
    "left_pct": 30, "center_pct": 40, "right_pct": 30,
    "footer_height": 88,
    "note": "initial; tune by grip test"
  }
}
